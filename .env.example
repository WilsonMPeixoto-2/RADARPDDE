# RADAR PDDE — exemplo seguro para desenvolvimento local
# Este arquivo não representa Preview ou Production.
# Production usa configuração gerenciada pela Vercel com dataMode=supabase-production.
RADAR_DATA_MODE=local
RADAR_ENVIRONMENT=local
RADAR_SUPABASE_REPOSITORY_ENABLED=false
RADAR_SUPABASE_URL=
RADAR_SUPABASE_PUBLISHABLE_KEY=
RADAR_SUPABASE_PRODUCTION_ACTIVATION_APPROVED=false

# Para Preview conectado, use variáveis gerenciadas no ambiente e dataMode=supabase-preview.
# Nunca adicione service_role, sb_secret_, senha do banco ou tokens administrativos.
