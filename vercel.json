{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|preview/final-visual-fixes-2026-09-26) exit 1 ;; dependabot/*) exit 0 ;; *) exit 0 ;; esac",
  "buildCommand": "npm run check && node scripts/build-vercel.mjs && node scripts/copy-controller-guide-assets.mjs && node scripts/build-vercel-output.mjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/"
    },
    {
      "source": "/carteira",
      "destination": "/"
    },
    {
      "source": "/competencias",
      "destination": "/"
    },
    {
      "source": "/pendencias",
      "destination": "/"
    },
    {
      "source": "/inventario",
      "destination": "/"
    },
    {
      "source": "/auditoria",
      "destination": "/"
    },
    {
      "source": "/equipe",
      "destination": "/"
    },
    {
      "source": "/gestao-sme",
      "destination": "/"
    },
    {
      "source": "/escolas/src/:path*",
      "destination": "/src/:path*"
    },
    {
      "source": "/escolas/vendor/:path*",
      "destination": "/vendor/:path*"
    },
    {
      "source": "/escolas/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/escolas/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/escolas/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/escolas/config.runtime.js",
      "destination": "/config.runtime.js"
    },
    {
      "source": "/escolas/:schoolId/src/:path*",
      "destination": "/src/:path*"
    },
    {
      "source": "/escolas/:schoolId/vendor/:path*",
      "destination": "/vendor/:path*"
    },
    {
      "source": "/escolas/:schoolId/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/escolas/:schoolId/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/escolas/:schoolId/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/escolas/:schoolId/config.runtime.js",
      "destination": "/config.runtime.js"
    },
    {
      "source": "/escolas/:path*",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview/final-visual-fixes-2026-09-26": true
    }
  }
}
